# Supabase is optional. The frontend defaults to synthetic data when these are
# unset. Copy this file to `.env.local` for Next.js and replace placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Explicit opt-in: `real` reads region_vintage_climate from Supabase and enables
# sourced MVT overlays. Use `synthetic` (or omit the variable) for demo mode.
NEXT_PUBLIC_DATA_SOURCE=synthetic

# Server-side only. Python commit operations read a project-root `.env`; the MVT
# route also reads these values and can fall back to the public URL/anon key.
# Never commit an actual service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional local PostgreSQL connection used by database tooling.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
